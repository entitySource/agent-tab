# ---- PayPal sandbox (Developer Dashboard > Apps & Credentials > Sandbox) ----
# Enable "Vault" and "Transaction Search" under the app's Advanced options.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook id from Dashboard > Webhooks (used for signature verification)
PAYPAL_WEBHOOK_ID=

# ---- Vault spike: where PayPal sends the buyer after approving the setup token ----
# Any reachable URL is fine for the spike; the script only needs the setup-token id.
SPIKE_RETURN_URL=https://example.com/agent-tab/return
SPIKE_CANCEL_URL=https://example.com/agent-tab/cancel

# ---- AI ----
ANTHROPIC_API_KEY=
AGENT_TAB_MODEL=claude-sonnet-5-5

# ---- Tab service ----
TAB_SERVICE_PORT=4100
TAB_SERVICE_URL=http://localhost:4100
DATABASE_URL=file:./dev.db
# Ed25519 keypair (JWK JSON) for signing line receipts
RECEIPT_PRIVATE_KEY_JWK=
RECEIPT_PUBLIC_KEY_JWK=

# ---- Demo seller ----
PAID_API_PORT=4200
PAID_API_MERCHANT_ID=research-data-demo

# ---- Ledger UI ----
NEXT_PUBLIC_TAB_SERVICE_URL=http://localhost:4100

# ---- Vault id for demo tabs (output of spike:token) ----
VAULT_ID=
