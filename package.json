{
  "name": "agent-tab",
  "private": true,
  "version": "0.1.0",
  "description": "A bar tab for AI agents, settled through PayPal.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "scripts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit false",
    "lint": "eslint .",
    "spike:setup": "tsx scripts/vault-spike.ts setup",
    "spike:token": "tsx scripts/vault-spike.ts token",
    "spike:charge": "tsx scripts/vault-spike.ts charge",
    "spike:status": "tsx scripts/vault-spike.ts status",
    "dev:api": "npm run dev -w apps/paid-data-api",
    "dev:tab": "npm run dev -w apps/tab-service",
    "dev:ledger": "npm run dev -w apps/ledger",
    "dev:agent": "npm run dev -w apps/research-agent"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/express": "^4.17.21",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.18.0"
  }
}
